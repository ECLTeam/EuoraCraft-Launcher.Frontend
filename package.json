{
  "name": "euoracraftlauncher-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "showcase": "vite --mode showcase",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "build:showcase": "pnpm typecheck && vite build --mode showcase",
    "preview": "vite preview",
    "lint": "eslint src eslint.config.js",
    "lint:fix": "eslint src eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@pinia/testing": "^2.0.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "jsrepo": "^3.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.0",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.2.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-inspect": "^12.0.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/vue": "^5.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@tanstack/vue-query": "^5.102.3",
    "@vueuse/core": "^14.0.0",
    "deepslate": "0.27.1",
    "dompurify": "^3.4.12",
    "gl-matrix": "3.4.4",
    "marked": "^18.0.7",
    "naive-ui": "^2.41.0",
    "pinia": "^4.0.2",
    "skinview3d": "3.4.2",
    "sucrase": "^3.35.0",
    "three": "^0.186.0",
    "valibot": "^1.0.0",
    "vue": "^3.5.26",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
